diff --git a/src/utils/roles.js b/src/utils/roles.js
new file mode 100644
index 0000000..4daf80d
--- /dev/null
+++ b/src/utils/roles.js
@@ -0,0 +1,43 @@
+/**
+ * Canonical staff role names, shared by the whole app.
+ *
+ * Source of truth: the backend's `api/models.py` ->
+ * `Users.ROLE_CHOICES` / `STAFF_ROLES`:
+ *
+ *   Admin | Administrator | HR Manager | HR | Recruiter
+ *
+ * `isStaffRole()` normalises case and whitespace so "HR Manager",
+ * "hr manager" and "HR_MANAGER" all match.
+ *
+ * Why this file exists: the role check used to be copy-pasted into
+ * `App.jsx`, `ProtectedRoute.jsx` and `tokenStorage.js`, and each copy
+ * only knew "admin" / "administrator". That sent every HR Manager and
+ * Recruiter to /quick-apply instead of /dashboard, and hid the
+ * Dashboard link in the header. There must be exactly ONE role helper
+ * in the app -- this one.
+ */
+
+export const STAFF_ROLES = [
+  "Admin",
+  "Administrator",
+  "HR Manager",
+  "HR",
+  "Recruiter",
+];
+
+const STAFF_ROLE_KEYS = new Set(
+  STAFF_ROLES.map((r) => r.toLowerCase().replace(/\s+/g, "_"))
+);
+
+/**
+ * True when the role is one of the staff roles that belong in the
+ * dashboard. Real enforcement is on the Django backend via JWT
+ * permission classes on every API call -- this only decides what the UI
+ * shows.
+ */
+export const isStaffRole = (role) => {
+  if (!role) return false;
+  return STAFF_ROLE_KEYS.has(
+    String(role).toLowerCase().replace(/\s+/g, "_")
+  );
+};
